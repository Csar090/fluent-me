    if(!sh.getRange(row,15).getValue()){
      const inbox=sheet_('Telegram Inbox'),values=inbox&&inbox.getLastRow()>1?inbox.getRange(2,1,inbox.getLastRow()-1,12).getValues():[],entry=values.find(r=>String(r[9])===String(body.sessionId));
